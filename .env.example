# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# App URL (required - used for QR codes, emails, sitemap, billing)
NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage (for file uploads)
# Create free project at https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Storage Driver: "supabase" (default), "minio", or "cloudinary"
STORAGE_DRIVER="supabase"

# Cloudinary (when STORAGE_DRIVER="cloudinary")
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# MinIO Configuration (when STORAGE_DRIVER="minio")
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="holocard"
MINIO_PUBLIC_URL="http://localhost:9000"

# Email - Resend (optional - features silently skip if not configured)
RESEND_API_KEY=""
EMAIL_FROM="hello@holocard.com"

# Stripe Billing (optional - returns 503 if not configured)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""

# AI Bio Generator - Ollama (local, optional)
OLLAMA_BASE_URL="http://localhost:11434"

# Contact email shown on site and used for contact form submissions
NEXT_PUBLIC_CONTACT_EMAIL="hello@holocard.com"

# Demo card slug for homepage links
NEXT_PUBLIC_DEMO_SLUG="usman-ashfaq"
