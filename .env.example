# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage (for file uploads)
# Create free project at https://app.supabase.com → Settings → API
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Storage Driver: "supabase" (default), "minio", or "cloudinary"
STORAGE_DRIVER="supabase"

# Cloudinary (when STORAGE_DRIVER="cloudinary")
# Create free account at https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# MinIO Configuration (when STORAGE_DRIVER="minio")
# Run MinIO: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="holocard"
MINIO_PUBLIC_URL="http://localhost:9000"

# AI Bio Generator - Ollama (local, optional)
OLLAMA_BASE_URL="http://localhost:11434"

# App URL
NEXT_PUBLIC_BASE_URL="https://holocard-fawn.vercel.app"
