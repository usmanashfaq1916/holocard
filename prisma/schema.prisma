generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CardStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  DISABLED
}

enum CardVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CardType {
  PERSONAL
  PROFESSIONAL
  BUSINESS
  PORTFOLIO
  EVENT
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum EventType {
  PROFILE_VIEW
  QR_SCAN
  QR_AR_SCAN
  QR_CARD_SCAN
  AR_LAUNCH
  AR_SESSION
  CONTACT_SAVE
  PHONE_CLICK
  EMAIL_CLICK
  WHATSAPP_CLICK
  LINKEDIN_CLICK
  WEBSITE_CLICK
  SOCIAL_CLICK
  CTA_CLICK
  SHARE
  VIDEO_PLAY
  CAMERA_STARTED
  TARGET_DETECTED
  AR_EXPERIENCE_STARTED
  AR_INTERACTION
}

enum ARExperienceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ARTargetStatus {
  PENDING
  COMPILING
  READY
  FAILED
}

enum ARElementType {
  THREE_D
  VIDEO
  IMAGE
  TEXT
  BUTTON
  AUDIO
  HTML_UI
}

enum ARActionType {
  OPEN_URL
  OPEN_LINKEDIN
  OPEN_GITHUB
  OPEN_INSTAGRAM
  OPEN_FACEBOOK
  OPEN_TWITTER
  OPEN_EMAIL
  OPEN_PHONE
  OPEN_WHATSAPP
  OPEN_YOUTUBE
  OPEN_TIKTOK
  SAVE_CONTACT
  OPEN_PROFILE
  OPEN_CONTENT
  PLAY_VIDEO
  PLAY_AUDIO
  TOGGLE_ELEMENT
}

enum ARSceneTransition {
  NONE
  FADE
  SLIDE
  SCALE
}

enum CardDesignSide {
  FRONT
  BACK
}

enum ARTemplateType {
  CORPORATE_INTRO
  CREATIVE_PORTFOLIO
  DEVELOPER
  REAL_ESTATE
  PRODUCT_SHOWCASE
  PERSONAL_BRAND
  DATA_ANALYST
}

enum MediaType {
  IMAGE
  VIDEO
  MODEL_3D
  AR_TARGET
}

enum TemplateStyle {
  CORPORATE
  EXECUTIVE
  DEVELOPER
  DATA_ANALYST
  DESIGNER
  FREELANCER
  STARTUP_FOUNDER
  REAL_ESTATE
  SALES
  MINIMAL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  company       String?
  designation   String?
  role          UserRole  @default(USER)
  plan          PlanTier  @default(FREE)
  preferences   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  cards            Card[]
  media            Media[]
  arAssets         ARAsset[]
  analyticsEvents  AnalyticsEvent[]
  subscriptions    Subscription[]
  passwordResets   PasswordResetToken[]
  notifications    Notification[]
  workspaces       Workspace[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Card {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String?
  projectId   String?
  slug        String     @unique
  name        String
  designation String?
  company     String?
  bio         String?
  phone       String?
  email       String?
  website     String?
  whatsapp    String?
  linkedin    String?
  facebook    String?
  instagram   String?
  twitter     String?
  location    String?
  profileImage String?
  companyLogo  String?
  status      CardStatus @default(DRAFT)
  cardType    CardType   @default(PROFESSIONAL)
  isPublic    Boolean    @default(true)
  visibility  CardVisibility @default(PUBLIC)
  order          Int        @default(0)
  accentColor    String?
  bgStyle        String?    @default("solid")
  bgImage        String?
  fontFamily     String?
  cardStyle      String?    @default("default")
  borderColor    String?
  shadowStyle    String?    @default("none")
  buttonStyle    String?    @default("solid")
  layoutStyle    String?    @default("centered")
  imageShape     String?    @default("circle")
  socialIconStyle String?   @default("rounded")
   metaTitle      String?
   metaDescription String?
   ogImage        String?
   allowIndexing  Boolean    @default(true)
   templateId     String?
   themeConfig    Json?
   about          String?
   skills         Json?
   experience     Json?
   projects       Json?
   enableContact  Boolean    @default(false)
   createdAt      DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  socialLinks    SocialLink[]
  analyticsEvents AnalyticsEvent[]
  media          Media[]
  arAssets       ARAsset[]
  buttons        CardButton[]
  contacts       Contact[]
  arExperience   ARExperience?
  cardDesigns    CardDesign[]

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([workspaceId])
  @@index([projectId])
}

model CardButton {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label     String
  icon      String?
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

model Contact {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name      String?
  email     String?
  phone     String?
  message   String?
  source    String?
  createdAt DateTime @default(now())

  @@index([cardId])
}

model SocialLink {
  id       String @id @default(cuid())
  cardId   String
  platform String
  url      String
  label    String?
  icon     String?
  order    Int    @default(0)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model Media {
  id        String    @id @default(cuid())
  userId    String
  cardId    String?
  type      MediaType
  filename  String
  url       String
  size      Int?
  width     Int?
  height    Int?
  duration  Float?
  mimeType  String?
  createdAt DateTime  @default(now())

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card?  @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cardId])
}

model ARAsset {
  id          String    @id @default(cuid())
  userId      String
  cardId      String?
  name        String
  type        String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card?  @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cardId])
}

model Template {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  style       TemplateStyle
  description String?
  thumbnail   String?
  config      Json
  isPremium   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([style])
  @@index([isActive])
}

model AnalyticsEvent {
  id         String    @id @default(cuid())
  cardId     String
  userId     String?
  eventType  EventType
  deviceType String?
  browser    String?
  country    String?
  referrer   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  card Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@index([eventType])
  @@index([createdAt])
  @@index([cardId, eventType])
  @@index([cardId, createdAt])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  plan      PlanTier
  status    String    @default("active")
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String   @default("info")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

model Workspace {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]
  cards    Card[]

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@index([workspaceId])
}

model ARExperience {
  id           String             @id @default(cuid())
  cardId       String             @unique
  name         String
  status       ARExperienceStatus @default(DRAFT)
  templateType ARTemplateType?
  sceneConfig  Json?
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  card     Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  target   ARTarget?
  scenes   ARScene[]

  @@index([cardId])
  @@index([status])
}

model ARTarget {
  id            String         @id @default(cuid())
  experienceId  String         @unique
  imageUrl      String
  mindFileUrl   String?
  quality       String?
  featureCount  Int?
  dimensions    Json?
  status        ARTargetStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  experience ARExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@index([status])
}

model ARScene {
  id             String           @id @default(cuid())
  experienceId   String
  name           String
  order          Int              @default(0)
  duration       Float            @default(5)
  transitionType ARSceneTransition @default(NONE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  experience ARExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  elements   ARElement[]

  @@index([experienceId])
}

model ARElement {
  id          String       @id @default(cuid())
  sceneId     String
  type        ARElementType
  assetUrl    String?
  position    Json         @default("{\"x\":0,\"y\":0,\"z\":0}")
  rotation    Json         @default("{\"x\":0,\"y\":0,\"z\":0}")
  scale       Json         @default("{\"x\":1,\"y\":1,\"z\":1}")
  visible     Boolean      @default(true)
  animation   Json?
  interaction Json?
  metadata    Json?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  scene   ARScene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  actions ARAction[]

  @@index([sceneId])
}

model ARAction {
  id        String     @id @default(cuid())
  elementId String
  type      ARActionType
  payload   Json?
  label     String?
  icon      String?
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  element ARElement @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@index([elementId])
}

model CardDesign {
  id             String         @id @default(cuid())
  cardId         String
  side           CardDesignSide
  width          Int            @default(1050)
  height         Int            @default(600)
  canvasJson     Json
  exportedImageUrl String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}
